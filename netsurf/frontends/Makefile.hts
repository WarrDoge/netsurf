# -*- mode: makefile-gmake -*-
##
## determine the HOST TARGET and SUBTARGET
##
## This tree is pruned to the framebuffer frontend and the monkey headless
## test driver; the original host-detection logic for RISC OS, BeOS/Haiku,
## AmigaOS, FreeMiNT and MinGW has been removed along with those frontends.
##

# Determine host type
HOST := $(shell uname -s)

# Sanitise host
# TODO: Ideally, we want the equivalent of s/[^A-Za-z0-9]/_/g here
HOST := $(subst .,_,$(subst -,_,$(subst /,_,$(HOST))))

# Setup (sub)targets

# empty default sub target
SUBTARGET=

# Default target is the framebuffer backend
ifeq ($(TARGET),)
  override TARGET := framebuffer
endif

# valid values for the TARGET
VLDTARGET := framebuffer monkey

# Check for valid TARGET
ifeq ($(filter $(VLDTARGET),$(TARGET)),)
  $(error Unknown TARGET "$(TARGET)", Must be one of $(VLDTARGET))
endif
